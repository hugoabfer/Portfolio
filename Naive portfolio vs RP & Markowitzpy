import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import minimize
import matplotlib.ticker as mtick

# Configuración visual global
plt.style.use('seaborn-v0_8-darkgrid')
plt.rcParams['figure.figsize'] = (10, 6)
plt.rcParams['font.size'] = 10

# Función auxiliar para formatear miles con punto (estilo europeo)
def formato_eur(numero):
    return f"{numero:,.0f}".replace(",", ".")


# 0. DESCARGA Y PREPARACIÓN DE DATOS
tickers_cartera = ['BTP10.MI', 'IDR.MC', 'IBE.MC', 'SXLE.AS', '4GLD.DE']
ticker_benchmark = 'URTH' # MSCI World
todos_los_tickers = tickers_cartera + [ticker_benchmark]

# Descarga de datos
data = yf.download(todos_los_tickers, period="20y", interval="1d", auto_adjust=False)['Close']
data = data.dropna(axis=1, how='all').ffill().dropna()

# Cálculo de retornos diarios
retornos_diarios = data.pct_change().dropna()
tickers_validos = [t for t in tickers_cartera if t in data.columns]
num_activos = len(tickers_validos)

# Separación de activos y benchmark
retornos_cartera = retornos_diarios[tickers_validos]
retornos_benchmark = retornos_diarios[ticker_benchmark]

# División Walk-Forward: 80% Train / 20% Test
corte = int(len(retornos_cartera) * 0.80)
retornos_train_cartera = retornos_cartera.iloc[:corte]
retornos_test_cartera = retornos_cartera.iloc[corte:]
retornos_test_benchmark = retornos_benchmark.iloc[corte:]

tasa_libre_riesgo = 0.025 # 2.5% anual
dias_año = 252

print(f"Periodo de entrenamiento (80%): {retornos_train_cartera.index[0].date()} a {retornos_train_cartera.index[-1].date()}")
print(f"Periodo de validación (20%):    {retornos_test_cartera.index[0].date()} a {retornos_test_cartera.index[-1].date()}")
print("-" * 80)

# Funciones Auxiliares de Evaluación
def calcular_metricas(curva, retornos, años):
    cagr = ((curva.iloc[-1] / 100) ** (1 / años)) - 1
    vol = retornos.std() * np.sqrt(dias_año)
    sharpe = (cagr - tasa_libre_riesgo) / vol if vol > 0 else 0
    return cagr, vol, sharpe

def plot_tarta(pesos, tickers, titulo):
    plt.figure()
    etiquetas = [t if p > 0.01 else "" for t, p in zip(tickers, pesos)]
    plt.pie(pesos, labels=etiquetas, autopct=lambda p: f'{p:.1f}%' if p > 1 else '',
            startangle=90, wedgeprops={'edgecolor': 'white'})
    plt.title(titulo, fontweight='bold', fontsize=14)
    plt.tight_layout()
    plt.show()

def configurar_eje_log(ax):
    """Aplica escala logarítmica forzando formato numérico estándar"""
    ax.set_yscale('log')
    formatter = mtick.ScalarFormatter()
    formatter.set_scientific(False)
    ax.yaxis.set_major_formatter(formatter)
    ax.yaxis.set_minor_formatter(formatter)

# Cálculos previos del Benchmark y la Equiponderada
pesos_iniciales = np.array([1/num_activos] * num_activos)
retornos_eq_test = retornos_test_cartera.dot(pesos_iniciales)
curva_eq = (1 + retornos_eq_test).cumprod() * 100

curva_bm = (1 + retornos_test_benchmark).cumprod() * 100
años_test = len(retornos_test_cartera) / dias_año

cagr_eq, vol_eq, sharpe_eq = calcular_metricas(curva_eq, retornos_eq_test, años_test)
cagr_bm, vol_bm, sharpe_bm = calcular_metricas(curva_bm, retornos_test_benchmark, años_test)

# Configuración base para simulaciones de Monte Carlo
np.random.seed(42)
sims = 1000
capital_inicial = 10000


# MODELO DE MARKOWITZ (Optimización de Ratio de Sharpe)

print("\n[Sección 1] Iniciando optimización de cartera Markowitz (Max Sharpe)...")

mu_train = retornos_train_cartera.mean() * dias_año
cov_train = retornos_train_cartera.cov() * dias_año

def objetivo_markowitz(pesos, mu, cov, rf):
    retorno = np.sum(mu * pesos)
    riesgo = np.sqrt(np.dot(pesos.T, np.dot(cov, pesos)))
    return -((retorno - rf) / riesgo)

restricciones = ({'type': 'eq', 'fun': lambda x: np.sum(x) - 1})
limites = tuple((0, 1) for _ in range(num_activos))

opt_markowitz = minimize(objetivo_markowitz, pesos_iniciales, args=(mu_train, cov_train, tasa_libre_riesgo),
                         method='SLSQP', bounds=limites, constraints=restricciones)
pesos_mk = opt_markowitz.x

# Gráfico 1: Asignación (Markowitz)
plot_tarta(pesos_mk, tickers_validos, 'Asignación Estratégica de Activos (Modelo Media-Varianza)')

# Backtest Markowitz
retornos_mk_test = retornos_test_cartera.dot(pesos_mk)
curva_mk = (1 + retornos_mk_test).cumprod() * 100
cagr_mk, vol_mk, sharpe_mk = calcular_metricas(curva_mk, retornos_mk_test, años_test)

# Gráfico 2: Evolución Out-Of-Sample (Markowitz)
fig, ax = plt.subplots()
ax.plot(curva_mk.index, curva_mk, color='#1f77b4', linewidth=2.5, label=f'Markowitz (Sharpe: {sharpe_mk:.2f})')
ax.plot(curva_eq.index, curva_eq, color='gray', linestyle='dashed', linewidth=1.5, label=f'Equiponderada (Sharpe: {sharpe_eq:.2f})')
ax.plot(curva_bm.index, curva_bm, color='black', linewidth=1.5, label=f'MSCI World (Sharpe: {sharpe_bm:.2f})')
ax.set_title('Evolución de Capital: Markowitz vs Benchmarks', fontweight='bold', fontsize=12)
ax.set_ylabel('Crecimiento del Patrimonio (Base 100)')
configurar_eje_log(ax)
ax.legend(loc='upper left')
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# Simulación Monte Carlo - Markowitz
mu_diario_mk = retornos_mk_test.mean()
std_diario_mk = retornos_mk_test.std()

rutas_mk = np.random.normal(mu_diario_mk, std_diario_mk, (dias_año, sims))
capital_caminos_mk = capital_inicial * (1 + rutas_mk).cumprod(axis=0)
capital_final_mk = capital_caminos_mk[-1, :]
media_capital_mk = np.mean(capital_final_mk)
var95_mk = np.percentile(capital_final_mk, 5)

# Gráfico 3: Trayectorias Estocásticas (Markowitz)
plt.figure()
plt.plot(capital_caminos_mk, color='blue', alpha=0.05)
plt.plot(capital_caminos_mk.mean(axis=1), color='red', linewidth=2.5, label=f'Media Esperada: {formato_eur(media_capital_mk)} €')
plt.axhline(capital_inicial, color='black', linestyle='--', linewidth=2, label=f'Capital Inicial ({formato_eur(capital_inicial)} €)')
plt.title('Proyección Estocástica de Capital a 1 Año (Markowitz)', fontweight='bold')
plt.ylabel('Valor del Portafolio (€)')
plt.legend()
plt.tight_layout()
plt.show()

# Gráfico 4: Distribución y VaR (Markowitz)
plt.figure()
plt.hist(capital_final_mk, bins=50, color='skyblue', edgecolor='black', alpha=0.7)
plt.axvline(media_capital_mk, color='blue', linestyle='dashed', linewidth=2, label=f'Media: {formato_eur(media_capital_mk)} €')
plt.axvline(capital_inicial, color='black', linestyle='solid', linewidth=2, label=f'Capital Inicial ({formato_eur(capital_inicial)} €)')
plt.axvline(var95_mk, color='red', linestyle='dashed', linewidth=2, label=f'VaR 95%: {formato_eur(var95_mk)} €')
plt.title('Distribución de Probabilidad y Valor en Riesgo (Markowitz)', fontweight='bold')
plt.xlabel('Capital Final Simulado (€)')
plt.ylabel('Frecuencia de Escenarios')
plt.legend()
plt.tight_layout()
plt.show()

print("-" * 80)


# MODELO DE RISK PARITY (Paridad de Riesgo)

print("\n[Sección 2] Iniciando optimización de cartera Risk Parity...")

cov_rp = retornos_train_cartera.cov() * dias_año

def objetivo_risk_parity(pesos, cov):
    riesgo_cartera = np.sqrt(np.dot(pesos.T, np.dot(cov, pesos)))
    contribucion_riesgo = pesos * (np.dot(cov, pesos) / riesgo_cartera)
    riesgo_objetivo = riesgo_cartera / len(pesos)
    return np.sum(np.square(contribucion_riesgo - riesgo_objetivo))

opt_risk_parity = minimize(objetivo_risk_parity, pesos_iniciales, args=(cov_rp,),
                           method='SLSQP', bounds=limites, constraints=restricciones)
pesos_rp = opt_risk_parity.x

# Gráfico 5: Asignación Estratégica (Risk Parity)
plot_tarta(pesos_rp, tickers_validos, 'Asignación Estratégica de Activos (Paridad de Riesgo)')

# Backtest Risk Parity
retornos_rp_test = retornos_test_cartera.dot(pesos_rp)
curva_rp = (1 + retornos_rp_test).cumprod() * 100
cagr_rp, vol_rp, sharpe_rp = calcular_metricas(curva_rp, retornos_rp_test, años_test)

# Gráfico 6: Evolución Out-Of-Sample (Risk Parity)
fig, ax = plt.subplots()
ax.plot(curva_rp.index, curva_rp, color='#2ca02c', linewidth=2.5, label=f'Risk Parity (Sharpe: {sharpe_rp:.2f})')
ax.plot(curva_eq.index, curva_eq, color='gray', linestyle='dashed', linewidth=1.5, label=f'Equiponderada (Sharpe: {sharpe_eq:.2f})')
ax.plot(curva_bm.index, curva_bm, color='black', linewidth=1.5, label=f'MSCI World (Sharpe: {sharpe_bm:.2f})')
ax.set_title('Evolución de Capital: Risk Parity vs Benchmarks', fontweight='bold', fontsize=12)
ax.set_ylabel('Crecimiento del Patrimonio (Base 100)')
configurar_eje_log(ax)
ax.legend(loc='upper left')
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# Simulación Monte Carlo - Risk Parity
mu_diario_rp = retornos_rp_test.mean()
std_diario_rp = retornos_rp_test.std()

rutas_rp = np.random.normal(mu_diario_rp, std_diario_rp, (dias_año, sims))
capital_caminos_rp = capital_inicial * (1 + rutas_rp).cumprod(axis=0)
capital_final_rp = capital_caminos_rp[-1, :]
media_capital_rp = np.mean(capital_final_rp)
var95_rp = np.percentile(capital_final_rp, 5)

# Gráfico 7: Trayectorias Estocásticas (Risk Parity)
plt.figure()
plt.plot(capital_caminos_rp, color='green', alpha=0.05)
plt.plot(capital_caminos_rp.mean(axis=1), color='red', linewidth=2.5, label=f'Media Esperada: {formato_eur(media_capital_rp)} €')
plt.axhline(capital_inicial, color='black', linestyle='--', linewidth=2, label=f'Capital Inicial ({formato_eur(capital_inicial)} €)')
plt.title('Proyección Estocástica de Capital a 1 Año (Risk Parity)', fontweight='bold')
plt.ylabel('Valor del Portafolio (€)')
plt.legend()
plt.tight_layout()
plt.show()

# Gráfico 8: Distribución y VaR (Risk Parity)
plt.figure()
plt.hist(capital_final_rp, bins=50, color='lightgreen', edgecolor='black', alpha=0.7)
plt.axvline(media_capital_rp, color='green', linestyle='dashed', linewidth=2, label=f'Media: {formato_eur(media_capital_rp)} €')
plt.axvline(capital_inicial, color='black', linestyle='solid', linewidth=2, label=f'Capital Inicial ({formato_eur(capital_inicial)} €)')
plt.axvline(var95_rp, color='red', linestyle='dashed', linewidth=2, label=f'VaR 95%: {formato_eur(var95_rp)} €')
plt.title('Distribución de Probabilidad y Valor en Riesgo (Risk Parity)', fontweight='bold')
plt.xlabel('Capital Final Simulado (€)')
plt.ylabel('Frecuencia de Escenarios')
plt.legend()
plt.tight_layout()
plt.show()

print("-" * 80)


# ANÁLISIS COMPARATIVO DE ESTRATEGIAS
print("\n[Sección 3] Analizando métricas de rendimiento comparativo (Out-of-Sample)...")

# Gráfico 9: Comparativa histórica conjunta
fig, ax = plt.subplots(figsize=(12, 7))
ax.plot(curva_mk.index, curva_mk, color='#1f77b4', linewidth=2.5, label=f'Markowitz (Sharpe: {sharpe_mk:.2f})')
ax.plot(curva_rp.index, curva_rp, color='#2ca02c', linewidth=2.5, label=f'Risk Parity (Sharpe: {sharpe_rp:.2f})')
ax.plot(curva_eq.index, curva_eq, color='gray', linestyle='dashed', linewidth=1.5, label=f'Equiponderada (Sharpe: {sharpe_eq:.2f})')
ax.plot(curva_bm.index, curva_bm, color='black', linewidth=1.5, label=f'MSCI World (Sharpe: {sharpe_bm:.2f})')

ax.set_title('Análisis Comparativo Institucional: Rentabilidad Histórica de las Carteras', fontweight='bold', fontsize=14)
ax.set_ylabel('Crecimiento del Patrimonio (Base 100)')
configurar_eje_log(ax)
ax.legend(loc='upper left', fontsize=10)
ax.grid(True, alpha=0.4)
plt.tight_layout()
plt.show()

# Resumen de resultados
tabla_comparativa = pd.DataFrame({
    'Modelo / Benchmark': ['Markowitz (Max Sharpe)', 'Risk Parity', 'Equiponderada (1/N)', 'MSCI World (URTH)'],
    'CAGR Anual': [f"{cagr_mk*100:.2f}%", f"{cagr_rp*100:.2f}%", f"{cagr_eq*100:.2f}%", f"{cagr_bm*100:.2f}%"],
    'Riesgo (Volatilidad)': [f"{vol_mk*100:.2f}%", f"{vol_rp*100:.2f}%", f"{vol_eq*100:.2f}%", f"{vol_bm*100:.2f}%"],
    'Ratio Sharpe': [f"{sharpe_mk:.2f}", f"{sharpe_rp:.2f}", f"{sharpe_eq:.2f}", f"{sharpe_bm:.2f}"],
    'VaR 95% (Monte Carlo)': [f"{formato_eur(var95_mk-capital_inicial)} €", f"{formato_eur(var95_rp-capital_inicial)} €", "N/A", "N/A"]
})

print("\n" + "="*90)
print("RESUMEN DE MÉTRICAS (DESEMPEÑO HISTÓRICO Y RIESGO PROYECTADO)")
print("="*90)
print(tabla_comparativa.to_string(index=False))
